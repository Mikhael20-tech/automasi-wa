{
  "name": "Otomasi Blast WA Welcome Maba 2026",
  "nodes": [
    {
      "parameters": {},
      "id": "start-node",
      "name": "When clicking 'Execute Workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "sheetId": {
          "__rl": true,
          "value": "https://docs.google.com/spreadsheets/d/1XU5LzIrpCxuMt3cmve7RIenDD5BmUgu3W46hml4kxT4/edit#gid=701539303",
          "mode": "url"
        },
        "range": "A:Z",
        "options": {}
      },
      "id": "google-sheets-node",
      "name": "Ambil Data Peserta (Google Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const getVal = (possibleKeys) => {\n  for (const k of possibleKeys) {\n    const foundKey = Object.keys($json).find(key => key.trim().toLowerCase().includes(k.toLowerCase()));\n    if (foundKey && $json[foundKey]) return String($json[foundKey]).trim();\n  }\n  return '';\n};\n\nconst nama = getVal(['Nama lengkap', 'Nama', 'nama']) || 'Peserta';\nconst rawWa = getVal(['Nomor WhatsApp', 'WhatsApp', 'wa', 'hp', 'telepon']);\nlet cleanWa = String(rawWa).replace(/[^0-9]/g, '');\nif (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.substring(1);\nelse if (cleanWa.startsWith('8')) cleanWa = '62' + cleanWa;\n\nconst hariTanggal = $json.Hari_Tanggal || 'Senin, 31 Agustus 2026';\nconst waktu = $json.Waktu || '17.30 (Open Gate) - Selesai';\nconst lokasi = $json.Lokasi || 'Ketintang Madya no.66';\n\nconst pesan = `Halo Kak ${nama}! 👋\n\nSemoga sehat selalu ya.\n\nMenjelang acara Welcome Maba 2026, kami dari tim panitia ingin melakukan konfirmasi kehadiran nih.\n\nApakah Kakak dipastikan bisa hadir di acara kita?\n\n🗓 Hari/Tanggal: ${hariTanggal}\n⏰ Waktu: ${waktu}\n📍 Lokasi: ${lokasi}\n\nMohon balas pesan ini dengan format:\n\n[Hadir / Tidak Hadir]\n\nKonfirmasi Kakak sangat membantu kami dalam penyiapan tempat & konsumsi. Terima kasih banyak! 🙏✨`;\n\nreturn {\n  json: {\n    ...$json,\n    target_wa: cleanWa,\n    pesan_formatted: pesan\n  }\n};"
      },
      "id": "format-pesan-node",
      "name": "Format Pesan WA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "loop-node",
      "name": "Loop Item (Satu per Satu)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "YOUR_FONNTE_API_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target_wa }}"
            },
            {
              "name": "message",
              "value": "={{ $json.pesan_formatted }}"
            }
          ]
        },
        "options": {}
      },
      "id": "send-wa-http-node",
      "name": "Kirim WA via Gateway (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "amount": 7,
        "unit": "seconds"
      },
      "id": "delay-node",
      "name": "Jeda Delay (7 Detik)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        300
      ],
      "webhookId": "delay-wait-webhook"
    }
  ],
  "connections": {
    "When clicking 'Execute Workflow'": {
      "main": [
        [
          {
            "node": "Ambil Data Peserta (Google Sheets)",
            "type": "main",
            "index": 0
          }
